---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% if page.collection == 'projects' %}
    <header class="post-header post-header--project">
      <div class="project-hero">
        {% if page.img %}
          <div class="project-hero__media">
            {% include figure.liquid loading="eager" path=page.img sizes="(min-width: 768px) 320px, 100vw" alt=page.title class="project-hero__image" %}
          </div>
        {% endif %}

        <div class="project-hero__content">
          <h1 class="post-title project-hero__title">{{ page.title }}</h1>
          {% if page.description %}
            <p class="post-description project-hero__summary">{{ page.description }}</p>
          {% endif %}
          {% if page.demo_url or page.github_url or page.github_front_url or page.github_back_url or page.pdf_url %}
            <div class="project-hero__links" aria-label="Project links">
              {% if page.demo_url %}
                <a class="project-hero__link" href="{{ page.demo_url }}" target="_blank" rel="noopener noreferrer">
                  <i class="fa-solid fa-play"></i>
                  <span>Demo</span>
                </a>
              {% endif %}
              {% if page.github_url %}
                <a class="project-hero__link" href="{{ page.github_url }}" target="_blank" rel="noopener noreferrer">
                  <i class="fa-brands fa-github"></i>
                  <span>GitHub</span>
                </a>
              {% endif %}
              {% if page.github_front_url %}
                <a class="project-hero__link" href="{{ page.github_front_url }}" target="_blank" rel="noopener noreferrer">
                  <i class="fa-brands fa-github"></i>
                  <span>GitHub (Front)</span>
                </a>
              {% endif %}
              {% if page.github_back_url %}
                <a class="project-hero__link" href="{{ page.github_back_url }}" target="_blank" rel="noopener noreferrer">
                  <i class="fa-brands fa-github"></i>
                  <span>GitHub (Back)</span>
                </a>
              {% endif %}
              {% if page.pdf_url %}
                {% if page.pdf_url contains '://' %}
                  {% assign project_pdf_url = page.pdf_url %}
                {% else %}
                  {% assign project_pdf_url = page.pdf_url | relative_url %}
                {% endif %}
                <a class="project-hero__link" href="{{ project_pdf_url }}" target="_blank" rel="noopener noreferrer">
                  <i class="fa-regular fa-file-pdf"></i>
                  <span>PDF</span>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="project-hero__details">
        <div class="project-hero__meta">
          {% if page.period or page.lab or page.tech_stack or page.highlights %}
            <ul class="project-meta-list">
              {% if page.period %}
                <li class="project-meta-list__item">
                  <span class="project-meta-item__label">Duration</span>
                  <span class="project-meta-item__value">{{ page.period }}</span>
                </li>
              {% endif %}
              {% if page.lab %}
                <li class="project-meta-list__item">
                  <span class="project-meta-item__label">Affiliation</span>
                  <span class="project-meta-item__value">{{ page.lab }}</span>
                </li>
              {% endif %}
              {% if page.tech_stack %}
                <li class="project-meta-list__item">
                  <span class="project-meta-item__label">Tech Stack</span>
                  <span class="project-meta-item__value">{{ page.tech_stack | join: ', ' }}</span>
                </li>
              {% endif %}
              {% if page.highlights %}
                <li class="project-meta-list__item">
                  <span class="project-meta-item__label">Key Highlights</span>
                  <div class="project-meta-item__value project-meta-item__value--chips">
                    {% for item in page.highlights %}
                      <span class="project-highlight-chip">{{ item }}</span>
                    {% endfor %}
                  </div>
                </li>
              {% endif %}
            </ul>
          {% endif %}
        </div>
      </div>
    </header>
  {% else %}
    <header class="post-header{% if page.collection == 'projects' %} post-header--project{% endif %}">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">{{ page.description }}</p>
    </header>
  {% endif %}

  <article class="page-content{% if page.collection == 'projects' %} page-content--project{% endif %}">
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus.enabled and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
