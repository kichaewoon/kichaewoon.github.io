<div class="col mb-4 project-list-item" data-tags="{% if project.tags %}{{ project.tags | join: '|' | escape }}{% endif %}">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable project-list-card">
      <div class="row no-gutters align-items-start">
        {% if project.img %}
          <div class="col-md-auto project-list-media">
            {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 180px, 35vw" alt="project thumbnail" class="card-img" %}
          </div>
        {% endif %}
        <div class="{% if project.img %}col{% else %}col-md-12{% endif %} project-list-content">
          <div class="card-body">
            <h3 class="card-title">{{ project.title }}</h3>
            {% if project.period %}
              <div class="project-period">{{ project.period }}</div>
            {% endif %}
            <p class="card-text">{{ project.description }}</p>
            {% if project.tags %}
              <div class="project-tag-list">
                {% for tag in project.tags %}
                  <span class="project-tag">{{ tag }}</span>
                {% endfor %}
              </div>
            {% endif %}
            <div class="row ml-1 mr-1 p-0">
              {% if project.github %}
                <div class="github-icon">
                  <div class="icon" data-toggle="tooltip" title="Code Repository">
                    <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
                  </div>
                  {% if project.github_stars %}
                    <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                      <i class="fa-solid fa-star"></i>
                      <span id="{{ project.github_stars }}-stars"></span>
                    </span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
